{
  "name": "School ERP (demo)",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "School ERP", "onAutoForward": "openBrowserOnce" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/start.sh"
}
