# Copy to .env.demo and edit. Used by docker-compose.yml (see docs/DEMO.md).
DOMAIN=demo.example.com
APP_URL=https://demo.example.com
DB_PASSWORD=change-this-long-random-password

# Public trial mode: landing page, one-click demo logins, banner, scheduled reset of ALL data.
SCHOOL_DEMO_MODE=true
SCHOOL_NAME="مدرستنا"
DEMO_RESET_HOURS=6
# How interested schools reach you: number with country code and no "+" (e.g. 962791234567) and/or an email.
DEMO_WHATSAPP=
DEMO_EMAIL=

# Leave APP_KEY empty in demo mode (a temporary one is generated on each start).
APP_KEY=
MESSAGING_CHANNEL=log
